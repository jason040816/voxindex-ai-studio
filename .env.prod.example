APP_PORT=80

POSTGRES_USER=daxi_voice
POSTGRES_PASSWORD=change-this-database-password
POSTGRES_DB=daxi_voice

SECRET_KEY=change-this-to-a-long-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

FRONTEND_APP_URL=https://your-frontend-domain.example
FRONTEND_ORIGINS=http://your-server-ip-or-domain

EMAIL_PROVIDER=smtp
SMTP_HOST=smtp.qiye.aliyun.com
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_SSL=true
SMTP_USE_TLS=false
SMTP_TIMEOUT_SECONDS=20
PASSWORD_RESET_EXPIRE_MINUTES=60

TTS_PROVIDER=tencent_flowtts
TENCENTCLOUD_SECRET_ID=your-tencent-secret-id
TENCENTCLOUD_SECRET_KEY=your-tencent-secret-key
TENCENTCLOUD_SDK_APP_ID=your-trtc-sdkappid
TENCENTCLOUD_REGION=ap-guangzhou
TENCENTCLOUD_ENDPOINT=trtc.tencentcloudapi.com
TENCENTCLOUD_MODEL=flow_01_ex

# Optional Alibaba Cloud OSS backup. Local Docker storage remains primary.
OSS_BACKUP_ENABLED=false
OSS_BUCKET=daxi-voice-storage
OSS_ENDPOINT=https://oss-cn-beijing.aliyuncs.com
OSS_REGION=cn-beijing
OSS_ACCESS_KEY_ID=your-ram-access-key-id
OSS_ACCESS_KEY_SECRET=your-ram-access-key-secret
OSS_PREFIX=voxindex

# Xingchen Zhichuang digital-human API. Keep the key on the backend only.
XINGCHEN_BASE_URL=https://open.xingchenzhichuang.com/api
XINGCHEN_API_KEY=your-xingchen-api-key
# This must be the public HTTPS address that Xingchen can use to fetch audio/callbacks.
DIGITAL_HUMAN_PUBLIC_BASE_URL=https://your-frontend-domain.example
DIGITAL_HUMAN_CALLBACK_URL=https://your-frontend-domain.example/api/digital-human/callback

# Stripe-hosted Checkout. Use matching test or live secrets; never place these in frontend code.
# Register https://your-frontend-domain.example/api/billing/stripe/webhook in Stripe Dashboard.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Legacy UPG gateway settings, retained only to query/receive historical orders.
# Configure the merchant-enabled currencies in Admin > Credits by adding each currency's package prices.
UPG_MERCHANT_ID=
UPG_SIGNING_KEY=
# Payment checkout base and API base are separate in the merchant documentation.
UPG_CHECKOUT_BASE_URL=
UPG_API_BASE_URL=
# Payment methods listed in the supplied documentation: Alipay CN, WeChat Pay (production only), Alipay HK, Credit Card.
# Replace with the actual payment methods enabled for this merchant account.
UPG_PAY_NOS=100000,100001,100003,100006
# Public URL that the payment platform can reach; the /api path must be reverse-proxied to FastAPI.
UPG_NOTIFICATION_BASE_URL=https://your-frontend-domain.example
UPG_BACKEND_URL=
UPG_RESPONSE_URL=
